{
  "name": "emmett-example-shopping-cart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full shopping cart sample using emmett + express-openapi-validator",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "run-s test:unit test:int test:e2e",
    "test:unit": "glob -d -c \"node --import tsx --import tsx/cjs --test\" \"test/**/*.unit.spec.ts\"",
    "test:int": "glob -d -c \"node --import tsx --import tsx/cjs --test\" \"test/**/*.int.spec.ts\"",
    "test:e2e": "glob -d -c \"node --import tsx --import tsx/cjs --test\" \"test/**/*.e2e.spec.ts\"",
    "test:watch": "run-p test:unit:watch test:int:watch test:e2e:watch",
    "test:unit:watch": "glob -d -c \"node --import tsx --import tsx/cjs --test --watch\" \"test/**/*.unit.spec.ts\"",
    "test:int:watch": "glob -d -c \"node --import tsx --import tsx/cjs --test --watch\" \"test/**/*.int.spec.ts\"",
    "test:e2e:watch": "glob -d -c \"node --import tsx --import tsx/cjs --test --watch\" \"test/**/*.e2e.spec.ts\""
  },
  "dependencies": {
    "@emmett-community/emmett-expressjs-with-openapi": "^0.9.0",
    "@emmett-community/emmett-google-firestore": "file:../..",
    "@emmett-community/emmett-observability": "^0.3.0",
    "@event-driven-io/emmett": "0.39.1",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-openapi-validator": "^5.6.0",
    "http-problem-details": "^0.1.7",
    "pino-http": "^9.0.0"
  },
  "devDependencies": {
    "@event-driven-io/emmett-expressjs": "0.39.1",
    "@types/express": "^4.17.21",
    "glob": "^11.0.0",
    "npm-run-all2": "^6.2.2",
    "testcontainers": "^10.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
